<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose 应用只需要一个非常简单的系统主题：
         界面全部由 Compose 绘制，这里只决定窗口背景/状态栏颜色。 -->
    <style name="Theme.WhatToEat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFBFF</item>
        <item name="android:statusBarColor">#FFFBFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- targetSdk 36 强制 edge-to-edge：导航栏透明，
             底部导航栏需要靠 Scaffold 的 insets 自行避让 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
